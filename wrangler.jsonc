{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cleaning-rating",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cleaning-rating-db",
      "database_id": "871b3c22-b53c-46b8-95a9-b3da96a2c31f",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "vars": {
    // Ошибки чтения D1 не маскируются seed-данными (lib/db/queries.ts → reportDbError)
    "STRICT_DB": "1"
  },
  // Семантический поиск (lib/search/semantic.ts). Индекс создаётся один раз:
  // wrangler vectorize create cleanhub-solutions --dimensions=1024 --metric=cosine
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "cleanhub-solutions" }
  ],
  // Лимиты на локацию Cloudflare, ключ = маршрут + IP (lib/security/guard.ts). period: только 10 или 60.
  "ratelimits": [
    { "name": "LEAD_LIMITER", "namespace_id": "2101", "simple": { "limit": 5, "period": 60 } },
    { "name": "EVENT_LIMITER", "namespace_id": "2102", "simple": { "limit": 120, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "2103", "simple": { "limit": 60, "period": 60 } },
    { "name": "ASSISTANT_LIMITER", "namespace_id": "2104", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
