{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cleaning-rating",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  // ID версии воркера для namespace incremental-кеша OpenNext: каждый деплой
  // получает пустой кеш и не может отдать HTML прошлой версии.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cleaning-rating-db",
      "database_id": "871b3c22-b53c-46b8-95a9-b3da96a2c31f",
      "migrations_dir": "migrations"
    }
  ],
  // Медиафайлы (видеоразборы протоколов). Отдаются роутом app/media/[...key]
  // на chistolab.pro/media/* — кастомный домен у бакета НЕ привязывать
  // (конфликт с хостом воркера).
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "chisyolab"
    }
  ],
  "vars": {
    // 0: мягкий откат на seed-данные если D1 ещё не засеяна или пуста
    "STRICT_DB": "0",
    "NEXT_PUBLIC_SITE_URL": "https://chistolab.pro",
    // Внешняя аналитика (грузится только после ch_consent="all" — см. ConsentBanner).
    // Пустые значения = счётчики выключены; задать реальные перед запуском рекламы.
    "NEXT_PUBLIC_CF_BEACON_TOKEN": "",
    "NEXT_PUBLIC_YM_ID": "",
    // Контейнер Google Tag Manager (Google-тег формата 2025+, без gtag('config')).
    "NEXT_PUBLIC_GTM_ID": "GTM-5N84R54Q",
    // Фото-триаж (открытая бета): "" = выключено. Включение — отдельное
    // решение после проверок приватности/бюджета; лимит попыток в день —
    // PHOTO_DAILY_BUDGET (атомарный счётчик D1 ai_usage_daily).
    "PHOTO_ASSIST_ENABLED": "",
    "PHOTO_DAILY_BUDGET": "40",
    // Публичный флаг видимости UI-секции (только с PHOTO_ASSIST_ENABLED="1").
    "NEXT_PUBLIC_PHOTO_BETA": ""
  },
  // Публичный домен: Workers Builds при деплое привяжет его к воркеру
  // (зона chistolab.pro должна быть активна на этом Cloudflare-аккаунте).
  "routes": [
    { "pattern": "chistolab.pro", "custom_domain": true },
    { "pattern": "www.chistolab.pro", "custom_domain": true }
  ],
  // Семантический поиск (lib/search/semantic.ts). AI-биндинг активен; Vectorize
  // подключается позже: wrangler vectorize create cleanhub-solutions --dimensions=1024 --metric=cosine
  "ai": { "binding": "AI" },
  // "vectorize": [
  //   { "binding": "VECTORIZE", "index_name": "cleanhub-solutions" }
  // ],
  // Лимиты на локацию Cloudflare, ключ = маршрут + IP (lib/security/guard.ts). period: только 10 или 60.
  "ratelimits": [
    { "name": "LEAD_LIMITER", "namespace_id": "2101", "simple": { "limit": 5, "period": 60 } },
    { "name": "EVENT_LIMITER", "namespace_id": "2102", "simple": { "limit": 120, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "2103", "simple": { "limit": 60, "period": 60 } },
    { "name": "ASSISTANT_LIMITER", "namespace_id": "2104", "simple": { "limit": 20, "period": 60 } },
    // Фото-триаж: отдельный дешёвый лимит поверх дневного бюджета D1.
    { "name": "PHOTO_LIMITER", "namespace_id": "2105", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
