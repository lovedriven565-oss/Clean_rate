{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/solutions/vino-na-divane",
        "http://localhost:3100/rating",
        "http://localhost:3100/companies/spectrclean",
        "http://localhost:3100/minsk/uborka-kvartir"
      ],
      "startServerCommand": "npm run start -- --port 3100",
      "startServerReadyPattern": "Ready in|started server",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
